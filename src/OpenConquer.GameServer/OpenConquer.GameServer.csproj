<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>OpenConquer.GameServer</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\..\content\maps\map-transitions.json"
             Link="content\maps\map-transitions.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\..\content\maps\map-definitions.json"
             Link="content\maps\map-definitions.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\..\content\maps\terrains\*.ocbt"
             Link="content\maps\terrains\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\..\content\maps\collision\*.ocmc"
             Link="content\maps\collision\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\..\content\items\item-types.json"
             Link="content\items\item-types.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenConquer.Application\OpenConquer.Application.csproj" />
    <ProjectReference Include="..\OpenConquer.Infrastructure\OpenConquer.Infrastructure.csproj" />
    <ProjectReference Include="..\OpenConquer.Protocol\OpenConquer.Protocol.csproj" />
    <ProjectReference Include="..\OpenConquer.Transport\OpenConquer.Transport.csproj" />
  </ItemGroup>
</Project>
